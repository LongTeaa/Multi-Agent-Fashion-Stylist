# Application
DATABASE_URL=sqlite:///./data/fashion_stylist.db
FRONTEND_URL=http://localhost:3000

# Provider model identifiers
VISION_PROVIDER=fake
VISION_TIMEOUT_SECONDS=30
INGESTION_MAX_CONCURRENCY=6
# auto follows VISION_PROVIDER; explicit choices: fake, gemini, yolo_world
DETECTOR_BACKEND=auto
YOLO_WORLD_MODEL_PATH=models/yolov8s-worldv2.onnx
YOLO_WORLD_CONFIDENCE_THRESHOLD=0.25
YOLO_WORLD_IOU_THRESHOLD=0.45
CONTEXT_PROVIDER=fallback
CONTEXT_TIMEOUT_SECONDS=15
WEATHER_PROVIDER=openmeteo
WEATHER_TIMEOUT_SECONDS=5
# Set to gemini for real lookbook generation.
IMAGE_PROVIDER=disabled
IMAGE_TIMEOUT_SECONDS=8
TRYON_PROVIDER=disabled
FASHN_TRYON_SPACE=fashn-ai/fashn-vton-1.5
HF_TOKEN=your_hf_token
TRYON_TIMEOUT_SECONDS=90
LLM_MODEL=provider_model_name
VISION_MODEL=provider_model_name
VISION_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional: defaults to VISION_MODEL if left unset
DETECTOR_MODEL=provider_model_name
IMAGE_MODEL=provider_image_model_name

# Provider credentials (placeholders only)
GEMINI_API_KEY=your_api_key
GEMINI_API_KEYS=your_api_key_1,your_api_key_2
GEMINI_KEY_COOLDOWN_SECONDS=60
WEATHER_API_KEY=your_weather_api_key

# Private object storage
OBJECT_STORAGE_BACKEND=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_SECURE=false
MINIO_BUCKET_WARDROBE=wardrobe-private
MINIO_BUCKET_THUMBNAILS=wardrobe-thumbnails
MINIO_BUCKET_TRYON=tryon-private
SIGNED_URL_TTL_SECONDS=900
